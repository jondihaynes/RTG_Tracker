{
  "name": "ready-to-go-status",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{mjs,ts}\"",
    "lint": "eslint",
    "test": "NODE_NO_WARNINGS=1 node --experimental-strip-types --test tests/**/*.test.ts",
    "test:watch": "NODE_NO_WARNINGS=1 node --experimental-strip-types --test --watch tests/**/*.test.ts",
    "sync:state": "node scripts/sync-state-to-kv.mjs",
    "gate": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
