# Copy this file to .env.local and change the values you want.
# If .env.local is not present, the app will also read a plain .env file.
# These values are safe to keep local and will not be overwritten by git pulls.
# The app also accepts Vercel-style unprefixed names such as APP_NAME and AUTH_CODE.

NEXT_PUBLIC_APP_NAME=Ready to Go
NEXT_PUBLIC_OWNER_NAME=Your Name
NEXT_PUBLIC_PAGE_TITLE=Ready to Go Status
NEXT_PUBLIC_PAGE_DESCRIPTION=A clean live status page for your current focus, next task, and recent history.
NEXT_PUBLIC_AUTH_CODE=1111

# Optional advanced overrides
NEXT_PUBLIC_STATE_STORAGE_KEY=ready-to-go-tracker-state
NEXT_PUBLIC_AUTH_STORAGE_KEY=ready-to-go-tracker-auth
NEXT_PUBLIC_SYNC_EVENT_NAME=ready-to-go-tracker-sync

# Vercel-compatible alternatives (also supported)
APP_NAME=Ready to Go
OWNER_NAME=Your Name
PAGE_TITLE=Ready to Go Status
PAGE_DESCRIPTION=A clean live status page for your current focus, next task, and recent history.
AUTH_CODE=1111
STATE_STORAGE_KEY=ready-to-go-tracker-state
AUTH_STORAGE_KEY=ready-to-go-tracker-auth
SYNC_EVENT_NAME=ready-to-go-tracker-sync
