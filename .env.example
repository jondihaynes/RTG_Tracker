# Copy this file to .env.local and update values for your own setup.
# The app prefers NEXT_PUBLIC_* keys for client-visible settings.
# Legacy unprefixed alternatives are also supported (APP_NAME, AUTH_CODE, etc).

# App text and auth
NEXT_PUBLIC_APP_NAME=Ready to Go
NEXT_PUBLIC_OWNER_NAME=Your Name
NEXT_PUBLIC_PAGE_TITLE=Ready to Go Status
NEXT_PUBLIC_PAGE_DESCRIPTION=A clean live status page for your current focus, next task, and recent history.
NEXT_PUBLIC_AUTH_CODE=1111

# Optional client storage/event keys
NEXT_PUBLIC_STATE_STORAGE_KEY=ready-to-go-tracker-state
NEXT_PUBLIC_AUTH_STORAGE_KEY=ready-to-go-tracker-auth
NEXT_PUBLIC_SYNC_EVENT_NAME=ready-to-go-tracker-sync

# Shared state backend options
# 1) Vercel KV (recommended for Vercel deployments)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 2) Redis (preferred over Vercel KV when REDIS_URL is set)
# REDIS_URL=redis://127.0.0.1:6379
